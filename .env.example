# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CanteenIQ Server Configuration
PORT=3000
APP_ENV=development
DEMO_MODE=true
UNPAID_ORDER_TIMEOUT_MINUTES=10

# Database & Supabase Configuration (Optional for production external PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/canteeniq"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Security & Payment Gateway
JWT_SECRET="canteeniq-dev-jwt-secret-key-998822"
PAYMENT_PROVIDER="mock_demo_gateway"
PAYMENT_WEBHOOK_SECRET="whsec_canteeniq_demo_key"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
